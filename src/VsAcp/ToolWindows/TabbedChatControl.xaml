<UserControl x:Class="VsAcp.ToolWindows.TabbedChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VsAcp.Controls">

    <!-- The whole tool window is one WebView2 page (Assets/chat-template.html + the Preact app in Web/): the tab strip,
         a chat per open tab and the footer. WPF only hosts it. -->
