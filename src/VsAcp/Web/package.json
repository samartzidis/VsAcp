{
  "name": "vsacp-chat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Chat UI (input box, status bars, banners) hosted in the VsAcp WebView2.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config vite.dev.config.ts",
    "test": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/*.test.mjs\""
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "dompurify": "3.4.17",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
